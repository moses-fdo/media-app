EXPO_PUBLIC_API_URL=https://media-desk-api.onrender.com
EXPO_PUBLIC_DEMO_ENABLED=false
# For production: APP_ENV=production, a deployed HTTPS API origin, and demo false.
# Never put provider secrets or signing passwords into EXPO_PUBLIC_* variables.

# Android push: download google-services.json for com.mediaops.staff from Firebase.
# Put it at mobile/google-services.json, or supply its path when building:
# GOOGLE_SERVICES_JSON=/absolute/path/google-services.json
