<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/upcoming_background">
<LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/upcoming_widget_heading" android:includeFontPadding="false" android:textSize="17sp" android:textColor="@color/upcoming_ink" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
  <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/upcoming_mark" android:importantForAccessibility="no" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_event_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone" android:focusable="true" android:background="?android:attr/selectableItemBackground">
  <TextView android:id="@+id/widget_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_accent" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/widget_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/upcoming_ink" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/widget_venue_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_event_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone" android:focusable="true" android:background="?android:attr/selectableItemBackground">
  <TextView android:id="@+id/widget_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_accent" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/widget_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/upcoming_ink" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/widget_venue_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_event_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone" android:focusable="true" android:background="?android:attr/selectableItemBackground">
  <TextView android:id="@+id/widget_time_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_accent" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/widget_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/upcoming_ink" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/widget_venue_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textSize="12sp" android:textColor="@color/upcoming_muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
  <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/upcoming_widget_connect" android:includeFontPadding="false" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:textColor="@color/upcoming_ink" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/widget_empty_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/upcoming_widget_connect_body" android:includeFontPadding="false" android:textSize="13sp" android:textColor="@color/upcoming_muted" android:maxLines="3" android:ellipsize="end" />
</LinearLayout>
<LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/upcoming_widget_not_synced" android:includeFontPadding="false" android:textSize="11sp" android:textColor="@color/upcoming_muted" android:maxLines="1" android:ellipsize="end" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/upcoming_widget_agenda" android:includeFontPadding="false" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/upcoming_accent" />
</LinearLayout>
</LinearLayout>
