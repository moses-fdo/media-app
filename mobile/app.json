{
  "expo": {
    "name": "Karunya Media Desk",
    "slug": "karunya-media-desk",
    "version": "1.1.1",
    "orientation": "default",
    "icon": "./assets/images/karunya-k-icon.png",
    "scheme": "mediaops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mediaops.staff"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F8F8F5",
        "foregroundImage": "./assets/images/karunya-k-adaptive.png",
        "monochromeImage": "./assets/images/karunya-k-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.mediaops.staff"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/karunya-k-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "b3c8639e-3130-448c-9cf6-ecd100f79711"
      }
    }
  }
}
