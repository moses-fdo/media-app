ENVIRONMENT=development
DATABASE_URL=sqlite:///./media_ops.db
REDIS_URL=redis://localhost:6379/0
DEMO_ENABLED=false
IN_PROCESS_SYNC=true
RATE_LIMIT_ENABLED=false
ADMIN_EMAIL=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
MOBILE_REDIRECT_URI=mediaops://auth
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
CLIENT_REDIRECT_URIS=
WORKSPACE_TIMEZONE=Asia/Kolkata
SOURCE_RETENTION_DAYS=90

# Optional shared-workspace registration. Requires ALLOWED_DOMAIN and ADMIN_EMAIL.
DOMAIN_AUTO_JOIN=false
