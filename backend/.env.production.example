# Media Ops Production Environment Configuration
ENVIRONMENT=production
WORKSPACE_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=https://your-domain.edu,mediaops://

# Production Database (PostgreSQL required in production)
DATABASE_URL=postgresql+psycopg://media:CHANGE_PASSWORD@postgres:5432/media
REDIS_URL=redis://redis:6379/0

# Encryption key for securing stored Gmail OAuth refresh tokens (keep secure and backed up)
ENCRYPTION_KEY=lF4jJyDeVUboXOwaElzgMcognSZQs0x9fqPTC7KnXIs=

# Google OAuth Credentials (Production HTTPS redirect URI required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.edu/api/v1/auth/callback
MOBILE_REDIRECT_URI=mediaops://auth

# Initial Administrator Email
ADMIN_EMAIL=


# Data Retention
SOURCE_RETENTION_DAYS=90
