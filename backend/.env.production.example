# Production API / worker / scheduler configuration. Never commit a filled file.
ENVIRONMENT=production
DEMO_ENABLED=false
IN_PROCESS_SYNC=false
RATE_LIMIT_ENABLED=true
WORKSPACE_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=https://app.yourdomain.edu
# Optional local browser testing against this API; never use a wildcard.
LOCAL_BROWSER_ORIGINS=
MOBILE_REDIRECT_URI=mediaops://auth
# Optional additional exact app redirect URLs, separated by commas.
CLIENT_REDIRECT_URIS=

DATABASE_URL=postgresql+psycopg://media:CHANGE_PASSWORD@postgres:5432/media
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=

# Generate a private Fernet key and keep a backed-up copy. There is no default key.
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.edu/api/v1/auth/callback
# Each Google account owns its Gmail connection and event list.
PERSONAL_ACCOUNTS=true
SOURCE_RETENTION_DAYS=90
AUTH_REQUESTS_PER_MINUTE=30
API_REQUESTS_PER_MINUTE=300
MAX_REQUEST_BYTES=1048576
# Set to your reverse proxy's trusted IP/CIDR, never a public wildcard.
FORWARDED_ALLOW_IPS=127.0.0.1
